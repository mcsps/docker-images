{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>eumel8/renovate-config"],
  "packageRules": [
    {
      "matchFileNames": ["busybox/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "busybox image"
    },
    {
      "matchFileNames": ["etcd-tools/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "etcd-tools image"
    },
    {
      "matchFileNames": ["golang/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "golang image"
    },
    {
      "matchFileNames": ["grafana/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "grafana image"
    },
    {
      "matchFileNames": ["kubectl/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "kubectl image"
    },
    {
      "matchFileNames": ["mimir/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "mimir image"
    },
    {
      "matchFileNames": ["nginx-non-root/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "nginx-non-root image"
    },
    {
      "matchFileNames": ["s3cmd/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "s3cmd image"
    },
    {
      "matchFileNames": ["socat/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "socat image"
    },
    {
      "matchFileNames": ["utils/**"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "utils image"
    },
    {
      "description": "Keep kubectl on the current Kubernetes minor until deliberately changed",
      "matchPackageNames": ["kubernetes/kubernetes"],
      "allowedVersions": ">=1.36.0 <1.37.0"
    }
  ]
}
